@{
}

@model List<Movie>

<table class="table table-bordered">
<thead class="fw-bold">
    <tr>
        <td>Category</td>
        <td>Title</td>
        <td>Year</td>
        <td>Director Name</td>
        <td>Rating</td>
        <td>Edited</td>
        <td>LentTo</td>
        <td>CopiedToPlex</td>
        <td>Notes</td>
    <tr>
</thead>


    @foreach(var x in Model)
    {
        <tbody> <!--Pull the information from each movie-->
            <td>@x.Category.CategoryName</td>
            <td>@x.Title</td>
            <td>@x.Year</td>
            <td>@x.Director</td>
            <td>@x.Rating</td>
            <td>@x.Edited</td>
            <td>@x.LentTo</td>
            <td>@x.CopiedToPlex</td>
            <td>@x.Notes</td>

            <td><a class="btn btn-info" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieID">Update</a></td>
        <td><a class="btn btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieID">Delete</a></td>
        </tbody>
     }


</table>